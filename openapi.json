{
  "openapi": "3.1.0",
  "info": {
    "title": "Instagram Scalable Image Upload & Metadata Service",
    "description": "\n## Cloud-Native Media Pipeline API\n\nThis service supports direct-to-S3 presigned multipart uploads, single-table DynamoDB index lookups, \nand non-blocking asynchronous hard purging using AWS SQS.\n\n### Usage Quickstart:\n1. Call **`POST /api/v1/images/upload-url`** to get an S3 presigned upload link and register metadata.\n2. Upload binary payload directly to S3 using the generated URL.\n3. Query active media assets using **`GET /api/v1/images`** (filters by `owner_id` or `category`).\n4. Retrieve secure GET download links using **`GET /api/v1/images/{owner_id}/{image_id}/download`**.\n5. Delete media assets asynchronously using **`DELETE /api/v1/images/{owner_id}/{image_id}`**.\n    ",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/images/upload-url": {
      "post": {
        "tags": [
          "Image Management"
        ],
        "summary": "Task 1.1: Initiate S3 Presigned Upload",
        "description": "Generates a presigned S3 upload configuration and initializes \nthe metadata lifecycle in DynamoDB with AVAILABLE status.",
        "operationId": "initiate_image_upload_api_v1_images_upload_url_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Returns S3 upload configuration and saves initial metadata to DynamoDB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images": {
      "get": {
        "tags": [
          "Image Management"
        ],
        "summary": "Task 1.2: List active images with search filters",
        "description": "Lists active images from DynamoDB. \nRequires at least one filter parameter (`owner_id` or `category`).\nAutomatically excludes items marked as `PENDING_DELETE`.",
        "operationId": "list_images_api_v1_images_get",
        "parameters": [
          {
            "name": "owner_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter images by Owner ID (uses GSI1)",
              "title": "Owner Id"
            },
            "description": "Filter images by Owner ID (uses GSI1)"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter images by Category (uses GSI2)",
              "title": "Category"
            },
            "description": "Filter images by Category (uses GSI2)"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns list of active images matching search parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ImageItemResponse"
                  },
                  "title": "Response List Images Api V1 Images Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{owner_id}/{image_id}/download": {
      "get": {
        "tags": [
          "Image Management"
        ],
        "summary": "Task 1.3: Get secure view/download URL",
        "description": "Retrieves image metadata and generates a secure, short-lived GET presigned URL for direct viewing/downloading.",
        "operationId": "get_image_download_url_api_v1_images__owner_id___image_id__download_get",
        "parameters": [
          {
            "name": "owner_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Owner Id"
            }
          },
          {
            "name": "image_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Image Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a temporary GET presigned S3 download URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{owner_id}/{image_id}": {
      "delete": {
        "tags": [
          "Image Management"
        ],
        "summary": "Task 1.4: Asynchronously delete an image",
        "description": "Soft-deletes the image metadata in DynamoDB (`PENDING_DELETE`) for instant API read exclusion,\nand dispatches a message to SQS for background S3 and DynamoDB hard deletion.",
        "operationId": "delete_image_api_v1_images__owner_id___image_id__delete",
        "parameters": [
          {
            "name": "owner_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Owner Id"
            }
          },
          {
            "name": "image_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Image Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Marks item as soft-deleted and enqueues job for SQS worker hard purge.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DownloadResponse": {
        "properties": {
          "image_id": {
            "type": "string",
            "title": "Image Id"
          },
          "download_url": {
            "type": "string",
            "title": "Download Url"
          }
        },
        "type": "object",
        "required": [
          "image_id",
          "download_url"
        ],
        "title": "DownloadResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageItemResponse": {
        "properties": {
          "image_id": {
            "type": "string",
            "title": "Image Id"
          },
          "owner_id": {
            "type": "string",
            "title": "Owner Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "s3_key": {
            "type": "string",
            "title": "S3 Key"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "caption": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Caption"
          }
        },
        "type": "object",
        "required": [
          "image_id",
          "owner_id",
          "category",
          "status",
          "s3_key",
          "created_at"
        ],
        "title": "ImageItemResponse"
      },
      "InitiateUploadRequest": {
        "properties": {
          "owner_id": {
            "type": "string",
            "title": "Owner Id",
            "description": "Unique identifier of the image owner",
            "example": "user_mario_42"
          },
          "file_name": {
            "type": "string",
            "title": "File Name",
            "description": "Original filename of the asset",
            "example": "vacation.jpg"
          },
          "content_type": {
            "type": "string",
            "title": "Content Type",
            "description": "MIME content type",
            "default": "image/jpeg",
            "example": "image/jpeg"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "description": "Category tag used for GSI indexing",
            "default": "general",
            "example": "travel"
          },
          "caption": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Caption",
            "description": "Optional text description",
            "example": "Summer in Rome"
          }
        },
        "type": "object",
        "required": [
          "owner_id",
          "file_name"
        ],
        "title": "InitiateUploadRequest"
      },
      "MessageResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "image_id": {
            "type": "string",
            "title": "Image Id"
          }
        },
        "type": "object",
        "required": [
          "message",
          "image_id"
        ],
        "title": "MessageResponse"
      },
      "UploadResponse": {
        "properties": {
          "image_id": {
            "type": "string",
            "title": "Image Id",
            "example": "2cd6bd3d-700b-4c0f-b216-ae396d07f500"
          },
          "s3_key": {
            "type": "string",
            "title": "S3 Key",
            "example": "uploads/user_mario_42/2cd6bd3d-700b-4c0f-b216-ae396d07f500/vacation.jpg"
          },
          "upload_id": {
            "type": "string",
            "title": "Upload Id",
            "example": "kQM4siMOcMAwZmCY2mdM..."
          },
          "upload_url": {
            "type": "string",
            "title": "Upload Url",
            "example": "http://localhost:4566/instagram-images-bucket/..."
          }
        },
        "type": "object",
        "required": [
          "image_id",
          "s3_key",
          "upload_id",
          "upload_url"
        ],
        "title": "UploadResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Image Management",
      "description": "Core operations for presigned upload generation, GSI-filtered querying, viewing, and async soft/hard deletion."
    }
  ],
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Docker Server"
    }
  ]
}